---
import type { CollectionEntry } from "astro:content";

interface Props {
  newerArticle?: CollectionEntry<"articles"> | null;
  olderArticle?: CollectionEntry<"articles"> | null;
}

const {
  newerArticle,
  olderArticle
} = Astro.props;
---

<nav
  aria-label="Navigasi artikel"
  class="mt-12 grid grid-cols-1 gap-4 border-t border-slate-200 pt-6 sm:grid-cols-2"
>
  <div>
    {newerArticle && (
      <a
        href={`/artikel/${newerArticle.id}`}
        class="group block rounded-xl border border-slate-200 p-4 transition hover:border-brand-300 hover:bg-brand-50"
      >
        <span class="text-xs text-slate-400">
          ← Artikel lebih baru
        </span>

        <p class="mt-2 font-semibold text-slate-700 group-hover:text-brand-700">
          {newerArticle.data.title}
        </p>
      </a>
    )}
  </div>

  <div>
    {olderArticle && (
      <a
        href={`/artikel/${olderArticle.id}`}
        class="group block rounded-xl border border-slate-200 p-4 text-left transition hover:border-brand-300 hover:bg-brand-50 sm:text-right"
      >
        <span class="text-xs text-slate-400">
          Artikel lebih lama →
        </span>

        <p class="mt-2 font-semibold text-slate-700 group-hover:text-brand-700">
          {olderArticle.data.title}
        </p>
      </a>
    )}
  </div>
</nav>