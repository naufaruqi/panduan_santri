
---
interface Props {
  size?: "normal" | "large";
}

const { size = "normal" } = Astro.props;
---

<div
  class:list={[
    "prose prose-slate max-w-none",
    "prose-headings:scroll-mt-24",
    "prose-headings:tracking-tight",
    "prose-headings:font-bold",
    "prose-h1:text-3xl",
    "prose-h2:text-2xl",
    "prose-h3:text-xl",
    "prose-h4:text-lg",
    "prose-a:text-brand-600",
    "prose-a:no-underline hover:prose-a:underline",
    "prose-img:rounded-xl",
    "prose-img:shadow-sm",
    "prose-blockquote:border-brand-600",
    "prose-blockquote:bg-brand-50",
    "prose-blockquote:rounded-r-lg",
    "prose-blockquote:py-1",
    "prose-table:text-sm",
    "prose-th:bg-slate-50",
    "prose-pre:rounded-xl",
    size === "large" ? "prose-lg" : "prose-base"
  ]}
>
  <slot />
</div>
