---
interface Props {
  author: string;
  date: string;
  readingTime?: number;
}

const {
  author,
  date,
  readingTime = 5
} = Astro.props;
---

<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-500">
  <span>{author}</span>

  <span aria-hidden="true">·</span>

  <time datetime={date}>{date}</time>

  <span aria-hidden="true">·</span>

  <span>{readingTime} menit membaca</span>
</div>