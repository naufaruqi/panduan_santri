---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;

const toc = headings.filter(
  (heading) =>
    heading.depth === 2 || heading.depth === 3
);
---

{toc.length > 0 && (
  <aside class="space-y-4">

    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">
      Pada Halaman Ini
    </h2>

    <nav aria-label="Daftar isi artikel">
      <ul class="space-y-1 border-l border-slate-200">

        {toc.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class:list={[
                "block border-l-2 py-1.5 transition",
                "hover:border-brand-600 hover:text-brand-600",
                heading.depth === 3
                  ? "ml-3 border-transparent pl-3 text-xs text-slate-500"
                  : "border-transparent pl-3 text-sm font-medium text-slate-700"
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}

      </ul>
    </nav>

  </aside>
)}