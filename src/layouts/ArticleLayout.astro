
---
import BaseLayout from "./BaseLayout.astro";
import Prose from "../components/Prose.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  category: string;
  categoryHref?: string;
  date: string;
  author: string;
  readingTime?: number;
  coverImage?: string;
  headings?: Heading[];
}

const {
  title,
  description = "",
  category,
  categoryHref = "/",
  date,
  author,
  readingTime = 5,
  coverImage,
  headings = []
} = Astro.props;
---

<BaseLayout
  title={`${title} | RUANG ILMU`}
  description={description}
  headings={headings}
>
  <article class="mx-auto max-w-3xl">

    <!-- BREADCRUMB -->
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-400">
      <a href="/" class="hover:text-brand-600">Beranda</a>
      <span class="mx-2">/</span>
      <a href={categoryHref} class="hover:text-brand-600">
        {category}
      </a>
    </nav>

    <!-- ARTICLE HEADER -->
    <header class="mb-8 border-b border-slate-200 pb-6">

      <a
        href={categoryHref}
        class="mb-4 inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700"
      >
        {category}
      </a>

      <h1 class="mb-5 text-3xl font-bold leading-tight tracking-tight text-slate-900 sm:text-4xl">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500">
        <span>{author}</span>
        <span>·</span>
        <time datetime={date}>{date}</time>
        <span>·</span>
        <span>{readingTime} menit membaca</span>
      </div>

    </header>

    <!-- COVER IMAGE -->
    {coverImage && (
      <figure class="mb-8">
        <img
          src={coverImage}
          alt={title}
          class="aspect-video w-full rounded-xl object-cover"
        />
      </figure>
    )}

    <!-- ARTICLE BODY -->
    <div class="article-content">
      <Prose>
        <slot />
      </Prose>
    </div>

  </article>

</BaseLayout>
